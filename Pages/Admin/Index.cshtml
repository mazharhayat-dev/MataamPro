@page
@model MataamPro.Pages.Admin.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MataamPro.SharedResource> T
@{ ViewData["Title"] = T["Admin"]; }
<div class="mb-8"><p class="text-sm font-semibold uppercase tracking-wider text-saudi">MataamPro · KSA</p><h1 class="mt-2 text-3xl font-extrabold">@T["Admin"]</h1><p class="mt-2 text-slate-500">Manage your restaurant workspace, permissions, and settings.</p></div>
<div class="grid gap-5 md:grid-cols-3"><a asp-page="/Admin/Menus/Index" class="card group rounded-2xl p-6 hover:border-saudi"><div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-saudi">☷</div><h2 class="mt-5 font-bold">@T["ManageMenu"]</h2><p class="mt-2 text-sm text-slate-500">@Model.MenusCount active menu items</p><span class="mt-5 block text-sm font-bold text-saudi">Open menu manager →</span></a><div class="card rounded-2xl p-6"><div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-2xl text-gold">♙</div><h2 class="mt-5 font-bold">@T["Users"]</h2><p class="mt-2 text-sm text-slate-500">Manage staff access and roles.</p><a asp-page="/Users/Index" class="mt-5 inline-flex rounded-full bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-800">Configure users →</a></div><div class="card rounded-2xl p-6"><div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-2xl text-slate-600">⚙</div><h2 class="mt-5 font-bold">@T["Settings"]</h2><p class="mt-2 text-sm text-slate-500">VAT, receipt, branch, and printer settings.</p><a asp-page="/Settings/Index" class="mt-5 inline-flex rounded-full bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-800">Open settings →</a></div></div>
<div class="card mt-6 p-6"><h2 class="font-bold">Restaurant profile</h2><div class="mt-5 grid gap-5 sm:grid-cols-2"><div><p class="text-xs uppercase tracking-wider text-slate-400">Business name</p><p class="mt-1 font-semibold">MataamPro Restaurant</p></div><div><p class="text-xs uppercase tracking-wider text-slate-400">Country</p><p class="mt-1 font-semibold">Kingdom of Saudi Arabia</p></div><div><p class="text-xs uppercase tracking-wider text-slate-400">Tax registration</p><p class="mt-1 font-semibold">VAT enabled · 15%</p></div><div><p class="text-xs uppercase tracking-wider text-slate-400">Currency</p><p class="mt-1 font-semibold">Saudi Riyal (SAR)</p></div></div></div>
