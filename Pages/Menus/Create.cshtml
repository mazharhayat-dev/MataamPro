@page
@model MataamPro.Pages.Menus.CreateModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MataamPro.SharedResource> T
@{ ViewData["Title"] = T["AddMenuItem"]; }
<div class="mx-auto max-w-3xl"><div class="mb-8"><a asp-page="/Menus/Index" class="text-sm font-semibold text-saudi">← @T["Menus"]</a><h1 class="mt-3 text-3xl font-extrabold">@T["AddMenuItem"]</h1><p class="mt-2 text-slate-500">Create a bilingual item for your Saudi menu.</p></div><form method="post" enctype="multipart/form-data" class="card space-y-6 p-6 sm:p-8"><div class="grid gap-5 sm:grid-cols-2"><label class="block"><span class="text-sm font-semibold">@T["NameEnglish"]</span><input asp-for="Menu.NameEn" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-saudi" required /></label><label class="block"><span class="text-sm font-semibold">@T["NameArabic"]</span><input asp-for="Menu.NameAr" dir="rtl" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-saudi" required /></label></div><label class="block"><span class="text-sm font-semibold">@T["Description"]</span><textarea asp-for="Menu.Description" rows="3" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-saudi"></textarea></label><div class="grid gap-5 sm:grid-cols-2"><label class="block"><span class="text-sm font-semibold">@T["Price"] (@T["SaudiRiyal"])</span><input asp-for="Menu.Price" type="number" min="0" step="0.01" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-saudi" required /></label><label class="block"><span class="text-sm font-semibold">Image</span><input asp-for="Image" type="file" accept="image/*" class="mt-2 block w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" /></label></div><label class="flex items-center gap-3"><input asp-for="Menu.IsAvailable" class="h-4 w-4 accent-saudi" /><span class="text-sm font-semibold">@T["Available"]</span></label><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><a asp-page="/Menus/Index" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold">@T["Cancel"]</a><button class="rounded-xl bg-saudi px-5 py-3 text-sm font-bold text-white">@T["SaveChanges"]</button></div></form></div>
