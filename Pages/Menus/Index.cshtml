@page
@model MataamPro.Pages.Menus.IndexModel
@using Microsoft.Extensions.Localization
@using MataamPro.Services
@inject IStringLocalizer<MataamPro.SharedResource> T
@inject IWebHostEnvironment Environment
@{
    ViewData["Title"] = T["Menus"];
}

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-saudi">MataamPro</p>
        <h1 class="mt-2 text-3xl font-extrabold">@T["ManageMenu"]</h1>
        <p class="mt-2 text-slate-500">Bilingual cafeteria items with prices in Saudi Riyal.</p>
    </div>
    <a asp-page="./Create" class="rounded-full bg-black px-6 py-2.5 font-semibold text-white transition hover:bg-gray-800">+ @T["AddMenuItem"]</a>
</div>

@if (!Model.Menus.Any())
{
    <div class="card px-6 py-16 text-center text-slate-400">No menu items available.</div>
}
else
{
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in Model.Menus)
        {
            <article class="card overflow-hidden">
                <img src="@MenuImageHelper.GetUrl(item.ImageUrl, Environment)" asp-append-version="true" alt="@item.NameEn" class="h-44 w-full object-cover" />
                <div class="p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h2 class="font-bold">@item.NameEn</h2>
                            <p class="mt-1 text-sm text-slate-500">@item.NameAr</p>
                        </div>
                        <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-bold text-saudi">@item.Price.ToString("N2") @T["SaudiRiyal"]</span>
                    </div>
                    <p class="mt-3 line-clamp-2 text-sm text-slate-500">@(string.IsNullOrWhiteSpace(item.Description) ? item.Category?.NameEn : item.Description)</p>
                    <div class="mt-5 flex gap-2">
                        <a asp-page="/Admin/Menus/Edit" asp-route-id="@item.Id" class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-center text-sm font-semibold">@T["Edit"]</a>
                        <a asp-page="/Admin/Menus/Delete" asp-route-id="@item.Id" class="rounded-lg border border-red-100 px-3 py-2 text-sm font-semibold text-red-600">@T["Delete"]</a>
                    </div>
                </div>
            </article>
        }
    </div>
}
