@page "/Orders/Details/{id:int}"
@model MataamPro.Pages.Orders.DetailsModel
@{
    ViewData["Title"] = "Order Details";
    var subtotal = Model.Order!.Items.Sum(item => item.Price * item.Quantity);
    var vat = decimal.Round(subtotal * 0.15m, 2, MidpointRounding.AwayFromZero);
    var grandTotal = subtotal + vat;
}

<div class="min-h-screen bg-gradient-to-br from-emerald-50 via-white to-green-100 px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <a asp-page="/Orders/Index" class="text-sm font-semibold text-saudi">&lt;- Orders</a>
                <h1 class="mt-3 text-3xl font-extrabold text-slate-900">Order #@Model.Order.Id.ToString("D4")</h1>
            </div>
            <button type="button" onclick="window.print()" class="print-button rounded-xl bg-black px-5 py-3 text-sm font-bold text-white shadow-sm">Print Bill</button>
        </div>

        <section class="card rounded-2xl bg-white p-6 shadow-lg">
            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <span class="text-sm text-slate-500">Date</span>
                    <p class="mt-1 font-bold text-slate-900">@Model.Order.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
                </div>
                <div>
                    <span class="text-sm text-slate-500">Table / Order type</span>
                    <p class="mt-1 font-bold text-slate-900">@(string.IsNullOrWhiteSpace(Model.Order.TableNo) ? "-" : Model.Order.TableNo) / @Model.Order.OrderType</p>
                </div>
                <div>
                    <span class="text-sm text-slate-500">Status</span>
                    <p class="mt-1 font-bold text-slate-900">@Model.Order.Status</p>
                </div>
            </div>

            <div class="mt-6 overflow-x-auto">
                <table class="w-full min-w-[620px] text-sm">
                    <thead class="border-b border-slate-200 text-xs uppercase text-slate-500">
                        <tr><th class="px-3 py-3 text-start">Item</th><th class="px-3 py-3 text-end">Qty</th><th class="px-3 py-3 text-end">Price</th><th class="px-3 py-3 text-end">Total</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
            @foreach (var item in Model.Order.Items)
            {
                <tr>
                    <td class="px-3 py-3">@(item.Menu?.NameEn ?? "Item")</td>
                    <td class="px-3 py-3 text-end">@item.Quantity</td>
                    <td class="px-3 py-3 text-end">@item.Price.ToString("N2") SAR</td>
                    <td class="px-3 py-3 text-end">@((item.Price * item.Quantity).ToString("N2")) SAR</td>
                </tr>
            }
                    </tbody>
                </table>
            </div>

            <div class="mt-6 ml-auto max-w-sm space-y-2 border-t border-slate-200 pt-4 text-sm text-slate-700">
                <div class="flex justify-between"><span>Subtotal</span><span>@subtotal.ToString("N2") SAR</span></div>
                <div class="flex justify-between"><span>VAT 15%</span><span>@vat.ToString("N2") SAR</span></div>
                <div class="flex justify-between text-xl font-extrabold text-slate-900"><span>Grand Total</span><span>@grandTotal.ToString("N2") SAR</span></div>
            </div>
        </section>
    </div>
</div>

<style>
    @@media print {
        .print-button { display: none !important; }
        body { background: #fff !important; }
    }
</style>
