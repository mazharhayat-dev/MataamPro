@page "/Orders/KOT/{id:int}"
@model MataamPro.Pages.Orders.KOTModel
@{
    Layout = null;
    var order = Model.Order!;
    var is58mm = Request.Query["size"].ToString() == "58";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KOT #@order.Id.ToString("D4") - MataamPro</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #eee; color: #000; font: 10px/1.35 "Courier New", monospace; }
        .ticket { width: 72mm; max-width: calc(100% - 12px); margin: 16px auto; padding: 4mm 0; background: #fff; }
        .receipt-58 { page: narrow; }
        .receipt-58 .ticket { width: 52mm; }
        h1, h2, p { margin: 0; } h1 { font-size: 15px; text-align: center; font-weight: 700; } h2 { margin: 2px 0 10px; font-size: 11px; text-align: center; font-weight: 400; }
        .meta { margin: 10px 0; }
        .meta div { display: flex; justify-content: space-between; gap: 8px; padding: 2px 0; }
        .rule { overflow: hidden; white-space: nowrap; margin: 6px 0; }
        .items-header { display: flex; justify-content: space-between; font-weight: 700; }
        .item { padding: 4px 0; }
        .item-name { font-weight: 700; overflow-wrap: anywhere; }
        .item-line { display: flex; justify-content: space-between; gap: 6px; }
        .note { margin-top: 12px; text-align: center; font-weight: 700; }
        @@media print {
            @@page { size: 80mm auto; margin: 0; }
            body { width: 80mm; background: #fff; font-family: monospace; font-size: 10px; }
            .ticket { width: 72mm; max-width: none; margin: 0 auto; padding: 3mm 0 0; }
            .receipt-58 { width: 58mm; }
            .receipt-58 .ticket { width: 52mm; }
            .receipt-58 .item-line { font-size: 9px; }
            @@page narrow { size: 58mm auto; margin: 0; }
        }
    </style>
</head>
<body class="@(is58mm ? "receipt-58" : "receipt-80")">
    <div class="controls" style="display:flex;justify-content:center;gap:8px;margin:12px 0;">
        <button type="button" onclick="window.print()">Print KOT</button>
    </div>
    <main class="ticket">
        <h1>MataamPro Cafeteria</h1>
        <h2>Kitchen Order Ticket</h2>
        <section class="meta">
            <div><span>Bill No:</span><span>#@order.Id.ToString("D4")</span></div>
            <div><span>Date:</span><span>@order.OrderDate.ToString("dd/MM/yyyy")</span></div>
            <div><span>Time:</span><span>@order.OrderDate.ToString("HH:mm")</span></div>
        </section>
        <div class="rule">--------------------------</div>
        <div class="items-header"><span>ITEM</span><span>QTY</span></div>
        <div class="rule">--------------------------</div>
        <section class="items">
            @foreach (var item in order.Items)
            {
                <div class="item">
                    <div class="item-name">@(item.Menu?.NameEn ?? "Item")</div>
                    <div class="item-line"><span>Kitchen preparation</span><strong>x@(item.Quantity)</strong></div>
                </div>
            }
        </section>
        <div class="rule">--------------------------</div>
        <p class="note">For Kitchen</p>
    </main>
</body>
</html>
