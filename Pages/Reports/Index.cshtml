@page
@model MataamPro.Pages.Reports.IndexModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MataamPro.SharedResource> T
@{ ViewData["Title"] = T["Reports"]; }
<div class="mb-8 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-semibold uppercase tracking-wider text-saudi">MataamPro · KSA</p><h1 class="mt-2 text-3xl font-extrabold">@T["DailySales"]</h1><p class="mt-2 text-slate-500">@Model.HijriDate</p></div><form method="get" class="flex gap-2"><input type="date" name="date" value="@Model.ReportDate.ToString("yyyy-MM-dd")" class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm" /><button class="rounded-xl bg-saudi px-4 py-3 text-sm font-bold text-white">View</button></form></div>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="card p-5"><p class="text-sm text-slate-500">@T["Date"]</p><p class="mt-3 text-xl font-extrabold">@Model.ReportDate.ToString("dd MMM yyyy")</p><p class="mt-2 text-sm text-saudi">@Model.HijriDate</p></div><div class="card p-5"><p class="text-sm text-slate-500">@T["TotalOrders"]</p><p class="mt-3 text-3xl font-extrabold">@Model.OrderCount</p></div><div class="card p-5"><p class="text-sm text-slate-500">Net sales</p><p class="mt-3 text-3xl font-extrabold">@Model.NetSales.ToString("N2") <small class="text-sm text-saudi">@T["SaudiRiyal"]</small></p></div><div class="card p-5"><p class="text-sm text-slate-500">@T["Vat"]</p><p class="mt-3 text-3xl font-extrabold text-gold">@Model.Vat.ToString("N2") <small class="text-sm text-slate-500">@T["SaudiRiyal"]</small></p></div></div>
<div class="card mt-6 flex items-center justify-between p-6"><div><p class="text-sm text-slate-500">Gross revenue</p><p class="mt-1 text-3xl font-extrabold text-saudi">@Model.GrossSales.ToString("N2") @T["SaudiRiyal"]</p></div><button onclick="window.print()" class="rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold">Print report</button></div>
