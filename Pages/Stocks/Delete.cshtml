@page "{id:int}"
@model MataamPro.Pages.Stocks.DeleteModel
@{
    ViewData["Title"] = "Delete Stock";
    var stock = Model.Stock!;
}

<div class="mx-auto max-w-xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-sm font-semibold text-saudi">← Inventory</a>
        <h1 class="mt-3 text-3xl font-extrabold">Delete stock item</h1>
    </div>
    <section class="card p-6">
        <p class="text-slate-600">Are you sure you want to delete <strong>@stock.Name</strong> (quantity @stock.Quantity)?</p>
        <form method="post" class="mt-6 flex gap-3">
            <input type="hidden" asp-for="Stock!.Id" />
            <button type="submit" class="rounded-xl bg-red-600 px-5 py-3 text-sm font-bold text-white">Delete</button>
            <a asp-page="Index" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold">Cancel</a>
        </form>
    </section>
</div>
