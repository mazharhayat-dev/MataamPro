@page "{id:int}"
@model MataamPro.Pages.Stocks.DetailsModel
@{
    ViewData["Title"] = "Stock Details";
    var stock = Model.Stock!;
}

<div class="mx-auto max-w-xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-sm font-semibold text-saudi">← Inventory</a>
        <h1 class="mt-3 text-3xl font-extrabold">@stock.Name</h1>
    </div>
    <section class="card space-y-4 p-6">
        <div><p class="text-sm text-slate-500">ID</p><p class="font-bold">#@stock.Id</p></div>
        <div><p class="text-sm text-slate-500">Quantity</p><p class="font-bold">@stock.Quantity</p></div>
        <a asp-page="Edit" asp-route-id="@stock.Id" class="inline-flex rounded-xl bg-black px-5 py-3 text-sm font-bold text-white">Edit</a>
    </section>
</div>
