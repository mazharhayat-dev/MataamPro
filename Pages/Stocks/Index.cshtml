@page
@model MataamPro.Pages.Stocks.IndexModel
@{
    ViewData["Title"] = "Stocks / المخزون";
}

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-saudi">MataamPro · KSA</p>
        <h1 class="mt-2 text-3xl font-extrabold">Stocks <span class="font-normal text-slate-400">/ المخزون</span></h1>
        <p class="mt-2 text-slate-500">Monitor ingredients and keep your kitchen supplied.</p>
    </div>
    <a asp-page="./Create" class="inline-flex items-center rounded-full bg-black px-5 py-2.5 text-sm font-bold text-white transition hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2">
        <span aria-hidden="true">+</span>
        <span class="ms-1">Create New / إنشاء جديد</span>
    </a>
</div>

<section class="card overflow-hidden rounded-2xl shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 p-5 sm:p-6">
        <div>
            <h2 class="font-bold text-slate-900">Inventory</h2>
            <p class="mt-1 text-sm text-slate-500">Track quantities and manage stock items.</p>
        </div>
        <label class="relative block w-full sm:w-72">
            <span class="sr-only">Search stocks</span>
            <svg class="pointer-events-none absolute start-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.5 3a5.5 5.5 0 1 0 3.447 9.786l3.633 3.634a.75.75 0 1 0 1.06-1.06l-3.633-3.633A5.5 5.5 0 0 0 8.5 3ZM4.5 8.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd" />
            </svg>
            <input id="stockSearch" type="search" placeholder="Search by name..." class="w-full rounded-full border border-slate-200 bg-slate-50 py-2.5 ps-9 pe-4 text-sm outline-none transition focus:border-black focus:bg-white" />
        </label>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full min-w-[720px] text-start text-sm" id="stocksTable">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-5 py-4 font-semibold">ID</th>
                    <th class="px-5 py-4 font-semibold">Name</th>
                    <th class="px-5 py-4 font-semibold">Quantity</th>
                    <th class="px-5 py-4 text-end font-semibold">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Stocks)
                {
                    <tr class="stock-row transition hover:bg-slate-50" data-stock-name="@item.Name">
                        <td class="px-5 py-4 font-semibold text-slate-400">#@item.Id</td>
                        <td class="px-5 py-4 font-bold text-slate-900">@item.Name</td>
                        <td class="px-5 py-4">
                            @if (item.Quantity < 20)
                            {
                                <span class="inline-flex rounded-full bg-red-50 px-3 py-1 text-xs font-bold text-red-700">@item.Quantity · Low stock</span>
                            }
                            else
                            {
                                <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">@item.Quantity · In stock</span>
                            }
                        </td>
                        <td class="px-5 py-4">
                            <div class="flex justify-end gap-2">
                                <a asp-page="Details" asp-route-id="@item.Id" class="rounded-full border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-700 transition hover:border-black hover:text-black">Details</a>
                                <a asp-page="Edit" asp-route-id="@item.Id" class="rounded-full bg-black px-3 py-2 text-xs font-semibold text-white transition hover:bg-gray-800">Edit</a>
                                <a asp-page="Delete" asp-route-id="@item.Id" class="rounded-full border border-red-100 px-3 py-2 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
                <tr id="noStockResults" class="hidden">
                    <td colspan="4" class="px-5 py-12 text-center text-slate-400">No matching stock items found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        const stockSearch = document.getElementById('stockSearch');
        const stockRows = [...document.querySelectorAll('.stock-row')];
        const noStockResults = document.getElementById('noStockResults');

        stockSearch.addEventListener('input', () => {
            const query = stockSearch.value.trim().toLowerCase();
            let visibleRows = 0;

            stockRows.forEach(row => {
                const matches = row.dataset.stockName.toLowerCase().includes(query);
                row.classList.toggle('hidden', !matches);
                if (matches) visibleRows++;
            });

            noStockResults.classList.toggle('hidden', visibleRows > 0);
        });
    </script>
}