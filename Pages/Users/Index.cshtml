@page
@model MataamPro.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
        <a asp-page="/Admin/Index" class="text-sm font-semibold text-saudi">← Administration</a>
        <h1 class="mt-3 text-3xl font-extrabold">Staff and roles</h1>
        <p class="mt-2 text-slate-500">Manage access to your restaurant workspace.</p>
    </div>
    <button type="button" class="rounded-full bg-black px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-800">
        + Invite staff
    </button>
</div>

<div class="grid gap-5 sm:grid-cols-3">
    <div class="card rounded-2xl p-5">
        <p class="text-sm font-medium text-slate-500">Total staff</p>
        <p class="mt-2 text-3xl font-extrabold">@Model.Staff.Count</p>
    </div>
    <div class="card rounded-2xl p-5">
        <p class="text-sm font-medium text-slate-500">Active accounts</p>
        <p class="mt-2 text-3xl font-extrabold text-saudi">@Model.Staff.Count(staff => staff.Status == "Active")</p>
    </div>
    <div class="card rounded-2xl p-5">
        <p class="text-sm font-medium text-slate-500">Roles in use</p>
        <p class="mt-2 text-3xl font-extrabold">@Model.Staff.Select(staff => staff.Role).Distinct().Count()</p>
    </div>
</div>

<section class="card mt-6 overflow-hidden rounded-2xl">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
        <div>
            <h2 class="font-bold">Team members</h2>
            <p class="mt-1 text-sm text-slate-500">Staff accounts and assigned permissions.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">@Model.Staff.Count accounts</span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-start text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-5 py-3 font-semibold">Staff member</th>
                    <th class="px-5 py-3 font-semibold">Role</th>
                    <th class="px-5 py-3 font-semibold">Status</th>
                    <th class="px-5 py-3 text-end font-semibold">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var staff in Model.Staff)
                {
                    <tr class="transition hover:bg-slate-50">
                        <td class="px-5 py-4">
                            <p class="font-bold text-slate-900">@staff.Name</p>
                            <p class="mt-1 text-xs text-slate-500">@staff.Email</p>
                        </td>
                        <td class="px-5 py-4">
                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@staff.Role</span>
                        </td>
                        <td class="px-5 py-4">
                            <span class="rounded-full @(staff.Status == "Active" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700") px-3 py-1 text-xs font-bold">@staff.Status</span>
                        </td>
                        <td class="px-5 py-4 text-end">
                            <button type="button" class="rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-black hover:text-black">Manage</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
