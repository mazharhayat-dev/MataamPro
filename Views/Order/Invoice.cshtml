@model MataamPro.Models.Order
@{
    Layout = null;
    var subtotal = Model.Items.Sum(item => item.Price * item.Quantity);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sale Invoice - #@Model.Id.ToString("D4")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; color: #000; background: #eee; font: 11px/1.35 "Courier New", monospace; }
        .receipt { width: 72mm; max-width: calc(100% - 16px); margin: 16px auto; padding: 4mm 0; background: #fff; }
        .receipt table { width: 100%; table-layout: fixed; }
        .receipt th, .receipt td { padding: 4px 0; vertical-align: top; }
        .receipt th:first-child, .receipt td:first-child { width: 44%; text-align: left; overflow-wrap: anywhere; }
        .receipt th:nth-child(2), .receipt td:nth-child(2) { width: 25%; text-align: right; }
        .receipt th:last-child, .receipt td:last-child { width: 31%; text-align: right; }
        .rule { border-top: 1px dashed #000; margin: 7px 0; }
        .footer { margin-top: 12px; text-align: center; font-weight: 700; }
        .print-button { display: block; width: fit-content; margin: 0 auto 12px; }
        @@media print {
            @@page { size: 80mm auto; margin: 0; }
            body { width: 80mm; background: #fff; }
            .receipt { width: 72mm; max-width: none; margin: 0 auto; padding: 4mm 0 0; }
            .print-button { display: none; }
        }
    </style>
</head>
<body>
    <button type="button" class="btn btn-dark btn-sm print-button" onclick="window.print()">Print invoice</button>
    <main class="receipt">
        <header class="text-center">
            <h1 class="h5 mb-1">MataamPro</h1>
            <div class="fw-bold">SALE INVOICE</div>
        </header>
        <div class="my-2">
            <div class="d-flex justify-content-between"><span>Order No:</span><span>#@Model.Id.ToString("D4")</span></div>
            <div class="d-flex justify-content-between"><span>Table:</span><span>@(Model.TableNo ?? "-")</span></div>
            <div class="d-flex justify-content-between"><span>Date:</span><span>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span></div>
        </div>
        <div class="rule"></div>
        <table>
            <thead>
                <tr><th>Item</th><th>Qty x Price</th><th>Amount</th></tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.Menu?.NameEn ?? "Item")</td>
                    <td>@item.Quantity x @item.Price.ToString("N2")</td>
                    <td>@((item.Quantity * item.Price).ToString("N2"))</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="rule"></div>
        <div class="d-flex justify-content-between fw-bold fs-6"><span>Total Sale</span><span>@subtotal.ToString("N2") SAR</span></div>
        <footer class="footer">Thank You</footer>
    </main>
    <script>
        window.addEventListener('load', function () { window.print(); });
    </script>
</body>
</html>